{
  "name": "dojofoo",
  "version": "0.1.0",
  "description": "Installable coding dojos that turn your AI agent into a sensei.",
  "keywords": [
    "cli",
    "dojo",
    "kata",
    "ai-agent",
    "claude",
    "claude-code",
    "coding-practice",
    "pair-programming"
  ],
  "license": "MIT",
  "author": "Tomas Sivicki <tomas.sivicki@gmail.com>",
  "homepage": "https://dojo.foo",
  "bugs": {
    "url": "https://github.com/dojofoo/dojofoo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dojofoo/dojofoo.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dojofoo": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @dojofoo/ui build && tsup && node scripts/bundle-ui.mjs",
    "test": "vitest run",
    "test:package": "node scripts/test-packed-ui.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@dojofoo/config": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jiti": "^2.7.0",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dojofoo/protocol": "workspace:*",
    "@dojofoo/ui": "workspace:*",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
